+  .hero{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:center;padding:24px 0 64px}
+  h1{font-family:var(--serif);font-weight:400;font-size:clamp(40px,5.2vw,64px);line-height:1.02;margin:16px 0 20px;letter-spacing:-.005em}
+  h1 em{font-style:italic;color:var(--amb)}
+  .lead{font-size:18px;color:var(--muted);max-width:34em;margin:0 0 28px}
+  .lead b{color:var(--paper);font-weight:600}
+  .cta{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
+  .btn{display:inline-flex;align-items:center;gap:10px;border-radius:999px;padding:15px 26px;font-weight:700;font-size:16px;text-decoration:none;transition:transform .15s ease, box-shadow .15s ease}
+  .btn.primary{background:var(--amb);color:#12201E;box-shadow:0 10px 28px rgba(226,159,101,.25)}
+  .btn.primary:hover{transform:translateY(-1px);box-shadow:0 14px 34px rgba(226,159,101,.32)}
